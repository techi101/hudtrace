+async def test_a_rollout_whose_agent_raises_is_graded_and_listed_as_failed_mid_run() -> None:
+    env = Environment("crashy")
+
+    @env.template()
+    async def check(behaviour: str):
+        answer = yield behaviour
+        yield 1.0 if answer == "yes" else 0.0
+
+    class Scripted(Agent):
+        async def __call__(self, run: Run) -> None:
+            if run.prompt_text in ("clean", "solve-then-crash"):
+                run.trace.content = "yes"
+            if run.prompt_text != "clean":
+                raise RuntimeError("gateway 403")
+
+    behaviours = ["clean", "solve-then-crash", "crash-immediately"]
+    rows = [Task(env="crashy", id="check", slug=b, args={"behaviour": b}) for b in behaviours]
+    job = await Taskset("crashy", rows).run(Scripted(AgentConfig()), runtime=LocalRuntime(env))
+
+    assert {trace.slug: (trace.is_error, trace.reward) for trace in job.traces} == {
+        "clean": (False, 1.0),
+        "solve-then-crash": (True, 1.0),
+        "crash-immediately": (True, 0.0),
+    }
+    assert job.errors == []
+    assert [trace.slug for trace in job.failed_mid_run] == ["solve-then-crash", "crash-immediately"]
+    assert job.reward == pytest.approx(2 / 3)
+
